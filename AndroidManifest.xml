<?xml version="1.0" encoding="utf-8"?>
<!-- No INTERNET permission: BentoPDF runs entirely from the APK, so the
     files you work on cannot leave the device. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kuscher.pdftoolbox"
    android:versionCode="10"
    android:versionName="0.7.2">

  <uses-sdk android:minSdkVersion="34" android:targetSdkVersion="37" />

  <!-- Google Play offers PDF Toolbox only to devices that say they are a PC:
       Googlebooks. Android itself doesn't check this, so the APK from GitHub
       still installs anywhere. -->
  <uses-feature android:name="android.hardware.type.pc" android:required="true" />

  <application
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:theme="@style/Theme.PDFToolbox"
      android:largeHeap="true"
      android:allowBackup="false">

    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:launchMode="singleTask"
        android:resizeableActivity="true"
        android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|locale|layoutDirection">
      <!-- Googlebook OS picks the size a window opens at itself (about 70% of
           the screen on an HP Googlebook 14, whatever this says); other
           desktop modes take this share of the screen. -->
      <layout
          android:defaultWidth="80%"
          android:defaultHeight="85%"
          android:minWidth="600dp"
          android:minHeight="480dp" />
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!-- Open with PDF Toolbox, and Share to PDF Toolbox: the files wait for
           the next tool you open. -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:scheme="content" />
        <data android:mimeType="application/pdf" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <action android:name="android.intent.action.SEND_MULTIPLE" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="application/pdf" />
        <data android:mimeType="image/*" />
        <data android:mimeType="text/*" />
        <data android:mimeType="application/msword" />
        <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
        <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
        <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
        <data android:mimeType="application/vnd.oasis.opendocument.text" />
        <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
        <data android:mimeType="application/vnd.oasis.opendocument.presentation" />
        <data android:mimeType="application/vnd.ms-excel" />
        <data android:mimeType="application/vnd.ms-powerpoint" />
        <data android:mimeType="application/epub+zip" />
        <data android:mimeType="message/rfc822" />
        <data android:mimeType="application/vnd.ms-outlook" />
      </intent-filter>
    </activity>
  </application>
</manifest>
